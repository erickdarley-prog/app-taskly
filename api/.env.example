PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/taskly
JWT_SECRET=troque-esta-chave-por-uma-bem-longa
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# Endereço do front usado nos links enviados por e-mail (botão "Concordo" do cliente).
APP_URL=http://localhost:5173
APP_FUSO=America/Sao_Paulo

# (Opcional) E-mail geral, usado por quem não configurou o próprio e-mail em "Minha conta".
SMTP_HOST=
SMTP_PORTA=587
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=

# ----- Anexos dos projetos -----
# Pasta onde os arquivos enviados ficam (padrão: api/uploads). Tamanho máximo por arquivo em MB.
PASTA_UPLOADS=
MAX_UPLOAD_MB=500

# ----- Assistente de chat (OpenAI) -----
# Cole sua chave entre o = e o fim da linha, sem aspas. Nunca compartilhe este arquivo.
OPENAI_API_KEY=
# Modelo usado pelo assistente. Opção mais barata: gpt-6-luna
OPENAI_MODEL=gpt-6.1-terra
# Esforço de raciocínio: none, low, medium ou high. Deixe vazio para modelos sem raciocínio (ex.: gpt-4o).
OPENAI_REASONING_EFFORT=low
