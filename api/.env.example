PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/taskly
JWT_SECRET=cambia-esta-clave-por-una-muy-larga
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# Dirección del front que se usa en los enlaces enviados por e-mail (botón "Acepto" del cliente).
APP_URL=http://localhost:5173
# Zona horaria usada en el diario y en las fechas de los e-mails (p. ej.: Europe/Madrid).
APP_HUSO=America/Sao_Paulo

# (Opcional) E-mail general, lo usa quien no haya configurado su propio e-mail en "Mi cuenta".
SMTP_HOST=
SMTP_PUERTO=587
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=

# ----- Adjuntos de los proyectos -----
# Carpeta donde se guardan los archivos subidos (predeterminada: api/uploads). Tamaño máximo por archivo en MB.
CARPETA_UPLOADS=
MAX_UPLOAD_MB=500

# ----- Asistente de chat (OpenAI) -----
# Pega tu clave entre el = y el final de la línea, sin comillas. Nunca compartas este archivo.
OPENAI_API_KEY=
# Modelo que usa el asistente. Opción más barata: gpt-6-luna
OPENAI_MODEL=gpt-6.1-terra
# Esfuerzo de razonamiento: none, low, medium o high. Déjalo vacío para modelos sin razonamiento (p. ej.: gpt-4o).
OPENAI_REASONING_EFFORT=low
